{
  "name": "listrello3",
  "version": "3.0.8",
  "license": "MIT",
  "private": true,
  "author": "Stephen Corbett",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "lint-fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "postinstall": "license-checker --production --json  --excludePackages 'listrello3@3.0.5' > ./src/assets/licences.json",
    "test:e2e": "start-server-and-test preview :4173 'cypress run --e2e --browser chrome'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' :4173 'cypress open --e2e'",
    "test:dev:e2e": "start-server-and-test 'vite dev --host 127.0.0.1 --port 4173' http://127.0.0.1:4173 'cypress open --e2e --browser electron'"
  },
  "dependencies": {
    "@mdi/font": "^7.1.96",
    "axios": "^1.19.0",
    "floating-vue": "^5.2.2",
    "is-mobile": "^5.0.0",
    "moment": "^2.29.4",
    "vue": "^3.5.41",
    "vue-router": "^5.3.0",
    "vuetify": "^3.13.2",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@cypress/vue": "^6.0.3",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.21.1",
    "eslint": "^10.9.1",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "license-checker": "^25.0.1",
    "netlify-plugin-csp-generator": "^1.6.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "start-server-and-test": "^2.1.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "jsdom": "16.7.0",
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=20.19.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveCorbett/LisTrello"
  }
}
